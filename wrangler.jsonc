{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "flue-sveltekit-demo",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-06-16",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare",
		"run_worker_first": ["/api/*"]
	},
	"services": [
		{
			"binding": "FLUE_AGENT",
			"service": "flue-sveltekit-agent"
		}
	],
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "THREADS_DB",
			"database_name": "flue-sveltekit-demo-threads",
			"database_id": "9edccc92-e765-4277-b286-e9225add7bde",
			"migrations_dir": "migrations"
		}
	]
}
