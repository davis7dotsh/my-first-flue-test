{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "flue-sveltekit-agent",
	"compatibility_date": "2026-06-16",
	"compatibility_flags": ["nodejs_compat"],
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["FlueRegistry", "FlueAssistantAgent"]
		}
	],
	"observability": {
		"enabled": true
	}
}
