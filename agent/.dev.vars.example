# Trusted agent integrations used by get_library_docs, search_web, and get_web_content.
FIRECRAWL_API_KEY=
CONTEXT7_API_KEY=

# The deferred Cloudflare Sandbox integration will not use an API key. Its
# future Container and Durable Object bindings are not configured yet.

# Optional local override. Production uses the dedicated gateway in agent/wrangler.jsonc.
AI_GATEWAY_ID=flue-sveltekit-demo-dev

# Workers AI uses the AI binding and does not require a model API key.
