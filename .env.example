# Local SvelteKit Worker configuration.
# Private agent-service credentials belong in agent/.dev.vars.

# Local web Worker -> local Flue agent fallback. Do not set this in production.
FLUE_AGENT_URL=http://127.0.0.1:3583

# Cloudflare Access application used to authenticate every web request.
CF_ACCESS_TEAM_DOMAIN=https://your-team.cloudflareaccess.com
CF_ACCESS_AUD=your-access-application-audience
